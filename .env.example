# Copy to .env before `docker compose up`. Host names are compose service names,
# resolvable inside the shared recipe-net network.

DATABASE_URL=postgres://recipes:recipes@postgres:5432/recipes?sslmode=disable
REDIS_URL=redis://redis:6379/0

# Must be at least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-byte-or-longer-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Service 2. The local model is slow, hence the long timeout; adaptation runs in
# a background worker so nothing user-facing blocks on it.
LLM_SERVICE_URL=http://llm-service:9000
LLM_SERVICE_TIMEOUT_SEC=180

# Adaptation worker pool. Keep this small: the bottleneck is one local GPU and
# llm-service serialises requests anyway.
ADAPT_WORKERS=2
ADAPT_QUEUE_SIZE=64
JOB_TTL=1h

HTTP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Only read by tools/ingest.
INGEST_CSV=/data/recipes.csv
